--!strict
-- Song and chart master data (prototype). The real data will live in Master_Songs (Open Cloud);
-- the Data/ modules are generated by tools/audio/make_charts.py and have the same fields.
-- A song is a short edit (about 90 s) cut into tend segments; every segment has an Easy / Normal / Hard chart.

local Types = require(script.Parent.RhythmEngine.Types)

export type SegmentData = {
	id: number,
	startMs: number,
	endMs: number,
	Easy: { Types.RawNote },
	Normal: { Types.RawNote },
	Hard: { Types.RawNote },
}

export type SongData = {
	songId: string,
	name: string,
	genre: string, -- Shared.Garden.Genres
	bpm: number,
	offsetMs: number,
	audioAssetId: string?,
	durationMs: number,
	beatsMs: { number }, -- tracked beat times (ms), for the metronome until real audio plays
	segments: { SegmentData },
}

export type Pick = {
	songId: string,
	name: string,
	genre: string,
	segment: Types.Segment,
	bpm: number,
	beatsMs: { number }, -- beats inside the segment (and the lead-in before it)
	offsetMs: number,
	audioAssetId: string?,
}

local Songs = {}

local list: { SongData } = {
	require(script.Data.KabukiDance) :: any,
	require(script.Data.DardAurDhamaka) :: any,
	require(script.Data.PastelTrip) :: any,
	require(script.Data.Kamikaze) :: any,
	require(script.Data.GorillaGlue) :: any,
	require(script.Data.FlyMeToTheSaitama) :: any,
	require(script.Data.MetropolitanExpressway) :: any,
	require(script.Data.NaniwaMarch) :: any,
	require(script.Data.BlueSamurai) :: any,
	require(script.Data.ShinjukuDeepRomance) :: any,
}
Songs.List = table.freeze(list)

local byId: { [string]: SongData } = {}
for _, song in list do
	byId[song.songId] = song
end

function Songs.get(songId: string): SongData?
	return byId[songId]
end

-- A random segment of the song at the given difficulty ("Easy" | "Normal" | "Hard").
function Songs.pick(songId: string, difficulty: string, rng: Random?): Pick?
	local song = byId[songId]
	if not song or #song.segments == 0 then
		return nil
	end
	local r = rng or Random.new()
	local seg = song.segments[r:NextInteger(1, #song.segments)]
	local notes = (seg :: any)[difficulty] :: { Types.RawNote }?
	if not notes then
		return nil
	end
	local beats: { number } = {}
	for _, b in song.beatsMs do
		if b >= seg.startMs - 4000 and b <= seg.endMs then
			table.insert(beats, b)
		end
	end
	return {
		songId = song.songId,
		name = song.name,
		genre = song.genre,
		segment = { segment = seg.id, startMs = seg.startMs, notes = notes },
		bpm = song.bpm,
		beatsMs = beats,
		offsetMs = song.offsetMs,
		audioAssetId = song.audioAssetId,
	}
end

return table.freeze(Songs)
